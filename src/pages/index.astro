    <div id="toasts"></div>

    <script>
      const $ = (s) => document.querySelector(s);
      const $$ = (s) => Array.from(document.querySelectorAll(s));
      const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

      function toast(msg) {
        const t = document.createElement("div");
        t.className = "toast";
        t.textContent = msg;
        $("#toasts").appendChild(t);
        setTimeout(() => t.remove(), 3200);
      }

      // ---------- badges ----------
      const BADGES = ["jr", "programmer", "mabar", "bintang"];
      function loadBadges() {
        try {
          const got = JSON.parse(localStorage.getItem("ff-badges") || "[]");
          got.forEach((b) => {
            const el = document.querySelector('[data-badge="' + b + '"]');
            if (el) el.classList.add("earned");
          });
        } catch (e) { /* abaikan */ }
      }
      function earnBadge(key, label) {
        const el = document.querySelector('[data-badge="' + key + '"]');
        if (!el || el.classList.contains("earned")) return;
        el.classList.add("earned");
        try {
          const got = JSON.parse(localStorage.getItem("ff-badges") || "[]");
          got.push(key);
          localStorage.setItem("ff-badges", JSON.stringify(got));
        } catch (e) { /* abaikan */ }
        toast("Badge dibuka: " + label + "!");
      }
      loadBadges();

      function confettiBurst(stage) {
        const colors = ["#1f5cff", "#ff8a00", "#8b5cf6", "#22d3ee", "#ff3b30", "#22c55e"];
        for (let i = 0; i < 26; i++) {
          const c = document.createElement("div");
          c.className = "confetti";
          c.style.left = Math.random() * 96 + "%";
          c.style.background = colors[i % colors.length];
          c.style.animationDelay = (Math.random() * 0.4) + "s";
          stage.appendChild(c);
          setTimeout(() => c.remove(), 2300);
        }
      }

      // ---------- nav ----------
      $("#hamburger").addEventListener("click", () => $("#navLinks").classList.toggle("open"));
      $$("#navLinks a").forEach((a) => a.addEventListener("click", () => $("#navLinks").classList.remove("open")));
      window.addEventListener("scroll", () => {
        $("#toTop").style.display = window.scrollY > 600 ? "block" : "none";
      });
      $("#toTop").addEventListener("click", () => window.scrollTo({ top: 0, behavior: "smooth" }));

      // ---------- reveal ----------
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) e.target.classList.add("visible"); });
      }, { threshold: 0.12 });
      $$(".reveal").forEach((el) => io.observe(el));

      // ---------- HERO mission ----------
      let heroPos = 6;
      const heroCat = $("#heroCat"), heroSpeech = $("#heroSpeech"), heroStage = $("#heroStage");
      function setHeroPos(p) {
        heroPos = Math.max(6, Math.min(78, p));
        heroCat.style.left = heroPos + "%";
        if (heroPos >= 74) heroWin();
      }
      function sayHero(text) { heroSpeech.textContent = text; }
      function heroWin() {
        heroCat.classList.add("dance");
        sayHero("HORE! Aku sampai! Kamu hebat!");
        confettiBurst(heroStage);
        earnBadge("jr", "Jr Coder");
        setTimeout(() => heroCat.classList.remove("dance"), 1800);
      }
      $$("[data-hero]").forEach((btn) => btn.addEventListener("click", () => {
        const act = btn.getAttribute("data-hero");
        if (act === "maju") { setHeroPos(heroPos + 17); sayHero("Maju! Sedikit lagi!"); }
        if (act === "lompat") {
          heroCat.classList.remove("jump"); void heroCat.offsetWidth;
          heroCat.classList.add("jump"); sayHero("Wheee! Lompat!");
        }
        if (act === "meong") { sayHero("Meong! Artinya: kamu keren!"); }
      }));
      $("#heroReset").addEventListener("click", () => {
        heroCat.classList.remove("sad");
        setHeroPos(6); sayHero("Ayo coba lagi! Kita pasti bisa!");
      });
      $("#heroAuto").addEventListener("click", async () => {
        setHeroPos(6); sayHero("Ikuti aku! Maju... maju...");
        await sleep(500);
        setHeroPos(heroPos + 17); await sleep(500);
        setHeroPos(heroPos + 17); await sleep(500);
        heroCat.classList.add("jump"); sayHero("Lompat!");
        await sleep(600);
        setHeroPos(heroPos + 17); await sleep(400);
        setHeroPos(heroPos + 17);
      });

      // ---------- PLAYGROUND ----------
      const script = [];
      const scriptList = $("#scriptList");
      const playCat = $("#playCat"), playSpeech = $("#playSpeech"), playStage = $("#playStage");
      let playPos = 6;
      const ACT_LABEL = { maju: "➜ maju 2 langkah", mundur: "⬅ mundur 1 langkah", lompat: "▲ lompat", putar: "⟳ putar / tari", halo: '◉ bilang "Halo!"', meong: "◉ meong!" };
      function renderScript() {
        scriptList.innerHTML = "";
        if (!script.length) {
          const li = document.createElement("li");
          li.style.background = "#fff";
          li.textContent = "— kosong, tambah blok dulu —";
          scriptList.appendChild(li);
          return;
        }
        script.forEach((act, i) => {
          const li = document.createElement("li");
          li.textContent = ACT_LABEL[act];
          li.title = "Klik buat hapus";
          li.addEventListener("click", () => { script.splice(i, 1); renderScript(); });
          scriptList.appendChild(li);
        });
      }
      $$("[data-add]").forEach((b) => b.addEventListener("click", () => {
        if (script.length >= 12) { toast("Skrip penuh! Maksimal 12 blok."); return; }
        script.push(b.getAttribute("data-add"));
        renderScript();
      }));
      $("#clearScript").addEventListener("click", () => { script.length = 0; renderScript(); });
      function playSay(t) { playSpeech.textContent = t; }
      $("#runScript").addEventListener("click", async () => {
        if (!script.length) { playSay("Tambah blok dulu biar aku jalan!"); return; }
        playSay("Siap... jalan!");
        for (const act of script) {
          if (act === "maju") { playPos = Math.min(78, playPos + 12); playCat.style.left = playPos + "%"; playSay("Maju!"); }
          if (act === "mundur") { playPos = Math.max(6, playPos - 7); playCat.style.left = playPos + "%"; playSay("Mundur dikit!"); }
          if (act === "lompat") { playCat.classList.remove("jump"); void playCat.offsetWidth; playCat.classList.add("jump"); playSay("Wheee!"); }
          if (act === "putar") { playCat.classList.remove("dance"); void playCat.offsetWidth; playCat.classList.add("dance"); playSay("La la la~"); await sleep(900); playCat.classList.remove("dance"); }
          if (act === "halo") playSay("Halo! Namaku Ciko!");
          if (act === "meong") playSay("Meong meong!");
          await sleep(650);
        }
        playSay("Selesai! Kamu programmer cilik!");
        confettiBurst(playStage);
        earnBadge("programmer", "Programmer Cilik");
      });
      renderScript();

      // ---------- GALLERY modal ----------
      const GAMES = {
        flying: { t: "Flying Ciko", d: "Ketuk / tekan spasi biar Ciko terbang lewatin gedung. Kalau nabrak, ulangi dari checkpoint.", tags: ["Scratch", "when key pressed", "variabel nyawa"], how: "Cara bikin: blok forever + if touching + change y. Anak kelas dasar sudah bisa dalam 2 pertemuan." },
        platform: { t: "Platform Petualang", d: "Lompat dari platform ke platform, kumpulin 10 koin emas secepat mungkin.", tags: ["Scratch", "variabel skor", "scrolling"], how: "Cara bikin: blok sensing warna tanah + variabel skor + timer. Favorit anak 10–12 tahun." },
        tap: { t: "Tap-Tap Pipa", d: "Ketuk layar biar Ciko lolos pipa hijau. Tiap lolos +1 poin, makin lama makin cepat.", tags: ["Scratch", "clone", "game over"], how: "Cara bikin: clone pipa + forever move + if touching. Karya Kirana dimainkan 3.200+ kali." },
        space: { t: "Animasi Antariksa", d: "Planet mengelilingi matahari dengan orbit masing-masing. Ada fakta sains tiap planet!", tags: ["Scratch", "broadcast", "pengetahuan"], how: "Cara bikin: blok motion go to + repeat berlapis + say. Belajar coding sekaligus sains." }
      };
      const modal = $("#modal");
      $$("[data-game]").forEach((b) => b.addEventListener("click", () => {
        const g = GAMES[b.getAttribute("data-game")];
        $("#modalTitle").textContent = g.t;
        $("#modalDesc").textContent = g.d;
        $("#modalTags").innerHTML = g.tags.map((t) => '<span class="tag">' + t + "</span>").join("");
        $("#modalHow").textContent = g.how;
        modal.classList.add("open");
        earnBadge("bintang", "Bintang Galeri");
      }));
      $("#modalClose").addEventListener("click", () => modal.classList.remove("open"));
      modal.addEventListener("click", (e) => { if (e.target === modal) modal.classList.remove("open"); });
      $("#modalCta").addEventListener("click", () => modal.classList.remove("open"));

      // ---------- AVATAR ----------
      const avatarCat = $("#avatarCat"), hatPreview = $("#hatPreview");
      $$(".swatch").forEach((s) => s.addEventListener("click", () => {
        $$(".swatch").forEach((x) => x.classList.remove("active"));
        s.classList.add("active");
        avatarCat.style.setProperty("--catchroma", s.getAttribute("data-color"));
      }));
      $("#hatSelect").addEventListener("change", (e) => { hatPreview.textContent = e.target.value; });
      $("#catName").addEventListener("input", (e) => {
        const v = e.target.value.trim() || "Ciko";
        $("#avatarName").textContent = v;
        $("#racerMeName").textContent = v;
      });

      // ---------- MABAR RACE ----------
      let me = 4, bot = 4, racing = false, botTimer = null;
      function paintRace() {
        $("#runMe").style.width = me + "%";
        $("#runBot").style.width = bot + "%";
      }
      function stopBot() { if (botTimer) { clearInterval(botTimer); botTimer = null; } }
      $("#makeRoom").addEventListener("click", () => {
        const code = Array.from({ length: 6 }, () => "ABCDEFGHJKMNPQRSTUVWXYZ23456789"[Math.floor(Math.random() * 31)]).join("");
        const rc = $("#roomCode");
        rc.style.display = "inline-block"; rc.textContent = code;
        const team = $("#teamList");
        team.innerHTML = "";
        const meName = ($("#catName").value.trim() || "Ciko") + " (kamu)";
        [meName].forEach((n) => {
          const s = document.createElement("span"); s.className = "mate"; s.textContent = n; team.appendChild(s);
        });
        $("#raceMsg").textContent = "Kode jadi! Bagikan ke teman sekelasmu...";
        setTimeout(() => {
          const s = document.createElement("span"); s.className = "mate"; s.textContent = "Mochi (Bot kelas) bergabung!"; team.appendChild(s);
          $("#raceMsg").textContent = "Mochi bergabung! Tekan Mulai Balapan!";
          toast("Mochi bergabung ke room!");
        }, 1200);
      });
      $("#raceStart").addEventListener("click", () => {
        if (!$("#roomCode").textContent || $("#roomCode").textContent === "------") { toast("Buat kode mabar dulu!"); return; }
        me = 4; bot = 4; racing = true; paintRace();
        $("#raceTap").disabled = false;
        $("#raceMsg").textContent = "BALAP MULAI! Spam tombol Kumpulkan Blok!";
        stopBot();
        botTimer = setInterval(() => {
          if (!racing) return;
          bot += 3 + Math.random() * 5;
          if (bot >= 100) { bot = 100; paintRace(); return finishRace("bot"); }
          paintRace();
        }, 800);
      });
      $("#raceTap").addEventListener("click", () => {
        if (!racing) return;
        me += 7 + Math.random() * 7;
        if (me >= 100) { me = 100; paintRace(); return finishRace("me"); }
        paintRace();
      });
      function finishRace(winner) {
        racing = false; stopBot();
        $("#raceTap").disabled = true;
        if (winner === "me") {
          $("#raceMsg").textContent = "MENANG! Kucingmu juara mabar!";
          confettiBurst($(".race-card"));
          earnBadge("mabar", "Raja Mabar");
        } else {
          $("#raceMsg").textContent = "Mochi menang tipis! Coba lagi, pasti bisa!";
        }
      }
      paintRace();

      // ---------- FORM ----------
      $("#trialForm").addEventListener("submit", (e) => {
        e.preventDefault();
        const nama = $("#fNama").value.trim() || "Coder Cilik";
        $("#successName").textContent = nama;
        $("#missionCode").textContent = "FF-" + Math.floor(1000 + Math.random() * 9000);
        $("#trialForm").style.display = "none";
        $("#formSuccess").style.display = "block";
        toast("Pendaftaran trial terkirim!");
      });
    </script>
  </body>
</html>

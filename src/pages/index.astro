<html lang="id">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Fun & Fine Learning Centre Karawang — les coding anak dengan Scratch. Main, bukan baca. Coba gratis!"
    />
    <title>Fun & Fine — Les Coding Anak yang Fun!</title>
    <style>
      :root {
        --yellow: #ffe900;
        --yellow-soft: #fff7ae;
        --blue: #1f5cff;
        --blue-dark: #0f3ec2;
        --navy: #0b2566;
        --ink: #14213d;
        --orange: #ff8a00;
        --purple: #8b5cf6;
        --cyan: #22d3ee;
        --red: #ff3b30;
        --green: #22c55e;
        --pink: #ff6fa5;
        --card: #ffffff;
        --radius: 22px;
        --shadow: 0 12px 32px rgba(11, 37, 102, 0.16);
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        font-family: "Trebuchet MS", "Segoe UI", Verdana, sans-serif;
        color: var(--ink);
        background: #fffdf0;
        overflow-x: hidden;
      }
      h1, h2, h3 { line-height: 1.15; margin: 0 0 12px; }
      p { line-height: 1.65; }
      .wrap { max-width: 1120px; margin: 0 auto; padding: 0 20px; }
      section { padding: 72px 0; }

      /* ---------- NAV ---------- */
      nav {
        position: sticky; top: 0; z-index: 50;
        background: var(--navy);
        border-bottom: 5px solid var(--yellow);
      }
      .nav-inner {
        max-width: 1120px; margin: 0 auto; padding: 10px 20px;
        display: flex; align-items: center; gap: 16px;
      }
      .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; color: #fff; font-weight: 900; font-size: 20px; }
      .brand img { width: 46px; height: 46px; border-radius: 50%; border: 3px solid var(--yellow); background: #fff; object-fit: cover; }
      .nav-links { display: flex; gap: 4px; margin-left: auto; }
      .nav-links a { color: #fff; text-decoration: none; font-weight: 700; padding: 9px 13px; border-radius: 12px; font-size: 15px; }
      .nav-links a:hover { background: rgba(255,255,255,.15); }
      .btn {
        display: inline-block; border: none; cursor: pointer; text-decoration: none;
        font-weight: 900; font-family: inherit; border-radius: 16px;
        padding: 13px 22px; font-size: 16px; transition: transform .12s ease, box-shadow .12s ease;
      }
      .btn:hover { transform: translateY(-2px); }
      .btn:active { transform: translateY(1px) scale(.98); }
      .btn-yellow { background: var(--yellow); color: var(--navy); box-shadow: 0 5px 0 #c9b800; }
      .btn-blue { background: var(--blue); color: #fff; box-shadow: 0 5px 0 var(--blue-dark); }
      .btn-green { background: var(--green); color: #063; box-shadow: 0 5px 0 #14803c; }
      .btn-red { background: var(--red); color: #fff; box-shadow: 0 5px 0 #b4231a; }
      .btn-ghost { background: #fff; color: var(--navy); box-shadow: 0 5px 0 #c9d4f5; border: 2px solid var(--navy); }
      .btn-flag { background: #22c55e; color: #fff; font-size: 20px; border-radius: 50%; width: 60px; height: 60px; padding: 0; box-shadow: 0 5px 0 #14803c; }
      #hamburger { display: none; background: var(--yellow); border: none; border-radius: 12px; font-size: 22px; font-weight: 900; padding: 8px 14px; cursor: pointer; margin-left: auto; }

      /* ---------- HERO ---------- */
      .hero {
        background:
          radial-gradient(circle at 12% 20%, rgba(34,211,238,.55) 0 90px, transparent 91px),
          radial-gradient(circle at 88% 12%, rgba(139,92,246,.5) 0 110px, transparent 111px),
          radial-gradient(circle at 85% 85%, rgba(31,92,255,.35) 0 130px, transparent 131px),
          radial-gradient(circle at 8% 88%, rgba(255,138,0,.4) 0 100px, transparent 101px),
          var(--yellow);
        border-bottom: 6px solid var(--navy);
        padding: 56px 0 64px;
        position: relative;
      }
      .hero-grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: 32px; align-items: center; }
      .pill {
        display: inline-block; background: var(--navy); color: #fff; font-weight: 800;
        padding: 8px 16px; border-radius: 999px; font-size: 14px; margin-bottom: 14px;
      }
      .hero h1 { font-size: clamp(34px, 5vw, 58px); color: var(--navy); letter-spacing: -1px; }
      .hero h1 .fun { color: var(--blue); }
      .hero p.lead { font-size: 18px; color: #3b4a6b; max-width: 46ch; }
      .hero-cta { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 18px; }
      .stats { display: flex; gap: 12px; margin-top: 22px; flex-wrap: wrap; }
      .stat { background: #fff; border: 3px solid var(--navy); border-radius: 16px; padding: 10px 16px; font-weight: 900; color: var(--navy); box-shadow: 4px 4px 0 var(--navy); }
      .stat small { display: block; font-weight: 700; color: #5b6b8c; font-size: 12px; }

      .stage-card {
        background: var(--card); border: 4px solid var(--navy); border-radius: var(--radius);
        box-shadow: var(--shadow); padding: 18px; position: relative;
      }
      .stage-card h3 { color: var(--navy); }
      .stage {
        position: relative; height: 230px; border-radius: 16px; overflow: hidden;
        background: linear-gradient(#bfe9ff 0 62%, #8ee06a 62% 100%);
        border: 3px dashed var(--blue);
      }
      .stage .gridline { position: absolute; top: 0; bottom: 0; width: 2px; background: rgba(31,92,255,.15); }
      .star-goal {
        position: absolute; right: 6%; bottom: 34%; font-size: 44px; color: var(--orange);
        animation: twinkle 1.2s infinite alternate;
      }
      @keyframes twinkle { from { transform: scale(1) rotate(-8deg); } to { transform: scale(1.25) rotate(8deg); } }
      .cat { position: absolute; bottom: 12%; left: 6%; width: 92px; transition: left .45s ease; }
      .cat.jump { animation: jump .55s ease; }
      @keyframes jump { 40% { transform: translateY(-58px) rotate(-8deg); } 100% { transform: translateY(0); } }
      .cat.dance { animation: dance .5s ease 3; }
      @keyframes dance { 25% { transform: rotate(-14deg) translateY(-10px); } 75% { transform: rotate(14deg) translateY(-10px); } }
      .cat.sad { filter: grayscale(.4); }
      .speech {
        position: absolute; top: 8px; left: 10px; background: #fff; border: 3px solid var(--navy);
        border-radius: 14px; padding: 6px 12px; font-weight: 800; font-size: 14px; max-width: 75%;
      }
      .fur { fill: var(--catchroma, #ff9421); }
      .hero-controls { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 14px; }
      .block-btn {
        border: 3px solid var(--navy); border-radius: 12px; padding: 10px 14px;
        font-weight: 900; font-family: inherit; cursor: pointer; font-size: 15px; color: #fff;
      }
      .block-btn:active { transform: scale(.95); }
      .b-blue { background: var(--blue); } .b-orange { background: var(--orange); }
      .b-purple { background: var(--purple); } .b-red { background: var(--red); }
      .b-green { background: var(--green); color: #063; }

      /* ---------- MARQUEE ---------- */
      .marquee { background: var(--navy); color: var(--yellow); overflow: hidden; white-space: nowrap; padding: 12px 0; font-weight: 900; font-size: 18px; }
      .marquee span { display: inline-block; padding-left: 100%; animation: slide 18s linear infinite; }
      @keyframes slide { to { transform: translateX(-100%); } }

      /* ---------- SECTION HEADERS ---------- */
      .kicker { display: inline-block; font-weight: 900; font-size: 14px; letter-spacing: 2px; text-transform: uppercase; color: #fff; background: var(--blue); padding: 7px 15px; border-radius: 999px; margin-bottom: 12px; }
      .kicker.pink { background: var(--pink); } .kicker.green { background: var(--green); color: #063; } .kicker.orange { background: var(--orange); }
      section h2 { font-size: clamp(26px, 3.6vw, 40px); color: var(--navy); }
      .sub { color: #4b5a78; max-width: 70ch; }

      /* ---------- PLAYGROUND ---------- */
      #kucing { background: #eef4ff; border-top: 6px solid var(--navy); border-bottom: 6px solid var(--navy); }
      .play-grid { display: grid; grid-template-columns: 300px 1fr; gap: 22px; margin-top: 24px; }
      .palette { background: #fff; border: 4px solid var(--navy); border-radius: var(--radius); padding: 16px; }
      .palette h3, .scriptbox h3 { color: var(--navy); font-size: 18px; }
      .scriptbox { background: #fff; border: 4px solid var(--navy); border-radius: var(--radius); padding: 16px; }
      #scriptList { list-style: none; padding: 0; margin: 12px 0; min-height: 64px; display: flex; flex-wrap: wrap; gap: 8px; }
      #scriptList li {
        background: var(--yellow); border: 3px solid var(--navy); border-radius: 12px;
        padding: 8px 12px; font-weight: 900; cursor: pointer; font-size: 14px;
      }
      #scriptList li:hover { background: var(--red); color: #fff; }
      #playStage { height: 250px; }

      /* ---------- GALLERY ---------- */
      .game-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 18px; margin-top: 26px; }
      .game-card { background: #fff; border: 4px solid var(--navy); border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); transition: transform .15s ease; }
      .game-card:hover { transform: translateY(-6px) rotate(-.5deg); }
      .thumb { height: 150px; display: flex; align-items: center; justify-content: center; font-size: 64px; font-weight: 900; color: #fff; }
      .t-fly { background: linear-gradient(135deg, var(--cyan), var(--blue)); }
      .t-platform { background: linear-gradient(135deg, var(--orange), var(--red)); }
      .t-tap { background: linear-gradient(135deg, var(--green), #0e9f6e); }
      .t-space { background: linear-gradient(135deg, var(--navy), var(--purple)); }
      .game-card .body { padding: 16px; }
      .game-card .body h3 { color: var(--navy); font-size: 19px; }
      .tags { display: flex; gap: 6px; flex-wrap: wrap; margin: 10px 0; }
      .tag { background: #eef4ff; border: 2px solid var(--blue); color: var(--blue-dark); font-size: 12px; font-weight: 800; padding: 3px 10px; border-radius: 999px; }
      .creator { font-size: 13px; color: #5b6b8c; font-weight: 700; }
      .split { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; margin-top: 28px; }
      .panel { background: #fff; border: 4px solid var(--navy); border-radius: var(--radius); padding: 20px; box-shadow: var(--shadow); }
      .panel h3 { color: var(--navy); }
      .board { list-style: none; padding: 0; margin: 0; }
      .board li { display: flex; align-items: center; gap: 10px; padding: 10px 4px; border-bottom: 2px dashed #d5ddf2; font-weight: 800; }
      .rank { background: var(--navy); color: var(--yellow); width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; border-radius: 50%; font-size: 15px; }
      .board li:first-child .rank { background: var(--orange); color: #fff; }
      .badges { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 6px; }
      .badge { border: 3px solid var(--navy); border-radius: 14px; padding: 10px 14px; font-weight: 900; background: #f1f3fa; color: #8a93ad; font-size: 14px; }
      .badge.earned { background: var(--yellow); color: var(--navy); box-shadow: 3px 3px 0 var(--navy); }

      /* ---------- MABAR ---------- */
      #mabar { background: var(--navy); color: #fff; }
      #mabar h2 { color: var(--yellow); }
      #mabar .sub { color: #cdd8f5; }
      .mabar-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; margin-top: 26px; }
      .avatar-card, .race-card { background: #fff; color: var(--ink); border: 4px solid var(--yellow); border-radius: var(--radius); padding: 20px; }
      .avatar-card h3, .race-card h3 { color: var(--navy); }
      .avatar-preview { display: flex; align-items: center; gap: 16px; background: #eef4ff; border-radius: 16px; padding: 14px; margin: 12px 0; position: relative; }
      .avatar-preview .cat { position: static; width: 110px; }
      .hat { position: absolute; font-size: 40px; top: -6px; }
      .swatches { display: flex; gap: 8px; margin: 10px 0; }
      .swatch { width: 38px; height: 38px; border-radius: 50%; border: 3px solid var(--navy); cursor: pointer; }
      .swatch.active { outline: 4px solid var(--yellow); }
      .field { margin: 12px 0; }
      .field label { font-weight: 900; display: block; margin-bottom: 6px; color: var(--navy); }
      .field input, .field select {
        width: 100%; padding: 12px; border-radius: 12px; border: 3px solid var(--navy);
        font-family: inherit; font-size: 15px; font-weight: 700;
      }
      .roomcode { font-size: 30px; font-weight: 900; letter-spacing: 6px; color: var(--blue-dark); background: var(--yellow); display: inline-block; padding: 8px 18px; border-radius: 14px; border: 3px dashed var(--navy); margin: 10px 0; }
      .racer { margin: 14px 0; }
      .racer .who { font-weight: 900; color: var(--navy); margin-bottom: 6px; }
      .track { background: #e6ebfa; border-radius: 999px; height: 30px; position: relative; overflow: hidden; border: 3px solid var(--navy); }
      .runner { height: 100%; width: 4%; border-radius: 999px; transition: width .3s ease; display: flex; align-items: center; justify-content: flex-end; font-size: 18px; }
      #runMe { background: linear-gradient(90deg, var(--blue), var(--cyan)); }
      #runBot { background: linear-gradient(90deg, var(--orange), var(--red)); }
      #raceMsg { font-weight: 900; min-height: 28px; color: var(--navy); margin-top: 10px; }
      .mabar-team { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 8px; }
      .mate { background: #eef4ff; border: 2px solid var(--blue); border-radius: 999px; padding: 5px 14px; font-weight: 800; font-size: 14px; color: var(--blue-dark); }

      /* ---------- PROGRAMS + CTA ---------- */
      .prog-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(270px, 1fr)); gap: 20px; margin-top: 26px; }
      .prog-card { background: #fff; border: 4px solid var(--navy); border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); }
      .prog-card img { width: 100%; height: 210px; object-fit: cover; display: block; border-bottom: 4px solid var(--navy); }
      .prog-card .body { padding: 18px; }
      .prog-card .body h3 { color: var(--navy); }
      .cta-box {
        margin-top: 30px; background: linear-gradient(135deg, var(--blue), var(--purple));
        border: 4px solid var(--navy); border-radius: 26px; padding: 34px; color: #fff;
        display: grid; grid-template-columns: 1fr 1fr; gap: 26px; align-items: center;
      }
      .cta-box h2 { color: var(--yellow); }
      .cta-form { background: #fff; border-radius: 18px; padding: 22px; color: var(--ink); }
      #formSuccess { display: none; text-align: center; }
      #formSuccess .code { font-size: 26px; font-weight: 900; color: var(--blue-dark); background: var(--yellow); border-radius: 12px; padding: 8px; margin: 12px 0; }
      .contact-chips { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 14px; }
      .contact-chips a { background: rgba(255,255,255,.15); color: #fff; border: 2px solid #fff; text-decoration: none; font-weight: 800; font-size: 14px; padding: 8px 14px; border-radius: 999px; }
      .contact-chips a:hover { background: #fff; color: var(--navy); }

      /* ---------- FAQ / FOOTER ---------- */
      details { background: #fff; border: 3px solid var(--navy); border-radius: 16px; padding: 14px 18px; margin: 10px 0; }
      details summary { font-weight: 900; cursor: pointer; color: var(--navy); font-size: 17px; }
      footer { background: var(--navy); color: #dbe4ff; padding: 40px 0; border-top: 6px solid var(--yellow); }
      footer a { color: var(--yellow); }
      .foot-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; }
      #toTop {
        position: fixed; right: 18px; bottom: 18px; z-index: 60; display: none;
        background: var(--yellow); border: 3px solid var(--navy); border-radius: 50%;
        width: 54px; height: 54px; font-size: 24px; font-weight: 900; cursor: pointer;
      }

      /* ---------- MODAL + TOAST + CONFETTI ---------- */
      #modal { display: none; position: fixed; inset: 0; z-index: 100; background: rgba(11,37,102,.7); align-items: center; justify-content: center; padding: 20px; }
      #modal.open { display: flex; }
      #modalCard { background: #fff; border: 5px solid var(--navy); border-radius: 24px; max-width: 520px; width: 100%; padding: 26px; position: relative; }
      #modalClose { position: absolute; top: 10px; right: 14px; background: var(--red); color: #fff; border: none; border-radius: 50%; width: 38px; height: 38px; font-size: 18px; font-weight: 900; cursor: pointer; }
      #toasts { position: fixed; left: 50%; transform: translateX(-50%); bottom: 22px; z-index: 120; display: flex; flex-direction: column; gap: 8px; align-items: center; }
      .toast { background: var(--navy); color: var(--yellow); font-weight: 900; padding: 12px 22px; border-radius: 999px; border: 3px solid var(--yellow); animation: pop .3s ease; }
      @keyframes pop { from { transform: scale(.7); opacity: 0; } }
      .confetti { position: absolute; width: 10px; height: 14px; top: -10px; animation: fall 1.6s ease-in forwards; z-index: 5; }
      @keyframes fall { to { transform: translateY(260px) rotate(540deg); opacity: 0; } }

      .reveal { opacity: 0; transform: translateY(28px); transition: all .6s ease; }
      .reveal.visible { opacity: 1; transform: none; }

      @media (max-width: 900px) {
        .hero-grid, .play-grid, .split, .mabar-grid, .cta-box { grid-template-columns: 1fr; }
        section { padding: 52px 0; }
      }
      @media (max-width: 640px) {
        .nav-links { display: none; position: absolute; top: 100%; left: 0; right: 0; background: var(--navy); flex-direction: column; padding: 12px 20px 18px; }
        .nav-links.open { display: flex; }
        #hamburger { display: block; }
        .stage { height: 200px; }
        .cat { width: 72px; }
      }
    </style>
  </head>
  <body>
    <nav>
      <div class="nav-inner">
        <a class="brand" href="#main"><img src="/img/logo.jpg" alt="Logo Fun and Fine" />Fun &amp; Fine</a>
        <button id="hamburger" aria-label="Buka menu">≡</button>
        <div class="nav-links" id="navLinks">
          <a href="#main">Main</a>
          <a href="#kucing">Kucing</a>
          <a href="#galeri">Galeri</a>
          <a href="#mabar">Mabar</a>
          <a href="#mulai" class="btn btn-yellow" style="padding:9px 16px;">Coba Gratis</a>
        </div>
      </div>
    </nav>

    <!-- HERO -->
    <header class="hero" id="main">
      <div class="wrap hero-grid">
        <div>
          <span class="pill">Les Coding Anak • Scratch • Karawang &amp; Online</span>
          <h1>Ngoding itu <span class="fun">MAIN</span>, bukan menghafal!</h1>
          <p class="lead">
            Di Fun &amp; Fine, anak bikin game sendiri bareng <strong>Ciko si Kucing</strong>.
            Klik blok, lihat kucingnya bergerak, langsung jadi game. Tanpa baca dokumen membosankan.
          </p>
          <div class="hero-cta">
            <button class="btn btn-green" id="heroAuto">▶ Jalankan Misi</button>
            <a class="btn btn-blue" href="#kucing">Programkan Kucing</a>
          </div>
          <div class="stats">
            <div class="stat">500+<small>Anak sudah main</small></div>
            <div class="stat">120+<small>Game buatan murid</small></div>
            <div class="stat">4-15<small>Usia tahun</small></div>
          </div>
        </div>
        <div class="stage-card">
          <h3>Misi 1: Bantu Ciko sampai ke bintang!</h3>
          <p style="margin:0 0 10px;font-size:14px;">Tekan tombol blok, atau <strong>Jalankan Misi</strong> biar Ciko jalan sendiri.</p>
          <div class="stage" id="heroStage">
            <div class="gridline" style="left:25%"></div>
            <div class="gridline" style="left:50%"></div>
            <div class="gridline" style="left:75%"></div>
            <div class="speech" id="heroSpeech">Halo! Aku Ciko. Bantu aku ya!</div>
            <div class="star-goal">★</div>
            <svg class="cat" id="heroCat" style="--catchroma:#ff9421" viewBox="0 0 120 120" aria-label="Ciko si kucing">
              <path d="M24 96 Q8 96 12 72" stroke="#ff9421" stroke-width="11" fill="none" stroke-linecap="round"/>
              <ellipse cx="60" cy="82" rx="30" ry="25" class="fur"/>
              <ellipse cx="60" cy="88" rx="15" ry="13" fill="#fff" opacity=".85"/>
              <polygon points="40,42 35,18 56,32" class="fur" stroke="#0b2566" stroke-width="2"/>
              <polygon points="80,42 85,18 64,32" class="fur" stroke="#0b2566" stroke-width="2"/>
              <polygon points="42,36 40,26 50,32" fill="#ff6fa5"/>
              <polygon points="78,36 80,26 70,32" fill="#ff6fa5"/>
              <circle cx="60" cy="54" r="26" class="fur" stroke="#0b2566" stroke-width="2"/>
              <rect x="50" y="28" width="6" height="12" rx="3" fill="#e06f00"/>
              <rect x="58" y="26" width="6" height="14" rx="3" fill="#e06f00"/>
              <rect x="66" y="28" width="6" height="12" rx="3" fill="#e06f00"/>
              <circle cx="50" cy="52" r="7" fill="#fff"/><circle cx="70" cy="52" r="7" fill="#fff"/>
              <circle cx="51" cy="53" r="3.4" fill="#14213d"/><circle cx="71" cy="53" r="3.4" fill="#14213d"/>
              <polygon points="60,60 55,65 65,65" fill="#ff6fa5"/>
              <path d="M60 65 Q60 70 54 70 M60 65 Q60 70 66 70" stroke="#14213d" stroke-width="2" fill="none"/>
              <path d="M28 56 L12 52 M28 62 L13 64 M92 56 L108 52 M92 62 L107 64" stroke="#14213d" stroke-width="1.6"/>
            </svg>
          </div>
          <div class="hero-controls">
            <button class="block-btn b-blue" data-hero="maju">➜ Maju</button>
            <button class="block-btn b-orange" data-hero="lompat">▲ Lompat</button>
            <button class="block-btn b-purple" data-hero="meong">◉ Meong</button>
            <button class="block-btn b-red" id="heroReset">↺ Ulangi</button>
          </div>
        </div>
      </div>
    </header>

    <div class="marquee"><span>MAIN • NGODING • BIKIN GAME • SCRATCH • KUCING CIKO • MABAR • BADGE • GALERI MURID • COBA GRATIS •&nbsp;</span></div>

    <!-- KUCING PROGRAMMABLE -->
    <section id="kucing">
      <div class="wrap">
        <span class="kicker">Level 2 • Kucing Programmable</span>
        <h2>Susun blok, Ciko langsung nurut!</h2>
